# Copy to .env.deploy at the repository root. Never commit actual secrets.
STACK_PREFIX=fatboy
DEPLOY_NETWORK=fatboy-production
POSTGRES_VOLUME=fatboy-postgres
UPLOADS_VOLUME=fatboy-uploads
BACKUP_STATUS_VOLUME=fatboy-backup-status
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
# Percent-encode the password in this URL if it contains reserved URL characters.
DATABASE_URL=postgresql://fatboy:REPLACE_WITH_A_RANDOM_PASSWORD@fatboy-db:5432/fatboy?schema=public
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_ORIGIN=https://inventarios.example.com
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_INITIAL_PASSWORD
API_UPSTREAM=http://fatboy-api:3000
API_IMAGE=fatboy-api
API_VERSION=local
WEB_IMAGE=fatboy-web
WEB_VERSION=local
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Configure these only for the backup service.
AGE_RECIPIENT=
BACKUP_REMOTE=
RCLONE_CONFIG_PATH=/etc/fatboy/rclone.conf
