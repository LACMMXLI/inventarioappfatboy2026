    "@nestjs/platform-express": "11.2.7",
    "@nestjs/schedule": "6.1.0",
    "@nestjs/swagger": "11.2.6",
    "@nestjs/throttler": "6.5.0",
    "@prisma/client": "6.19.3",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "exceljs": "4.4.0",
    "helmet": "8.1.0",
