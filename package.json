{
  "name": "fatboy-inventarios",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @fatboy/contracts build && pnpm --parallel --filter @fatboy/api --filter @fatboy/web dev",
    "build": "pnpm --filter @fatboy/contracts build && pnpm --filter @fatboy/api build && pnpm --filter @fatboy/web build",
    "test": "pnpm --filter @fatboy/api test && pnpm --filter @fatboy/web test",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @fatboy/api db:generate",
    "db:migrate": "pnpm --filter @fatboy/api db:migrate",
    "db:seed": "pnpm --filter @fatboy/api db:seed",
    "db:local": "node scripts/local-postgres.mjs",
    "test:prepare": "node scripts/prepare-tests.mjs",
    "test:restore": "node scripts/verify-restore.mjs",
    "format": "prettier --write apps/*/src packages/contracts/src scripts tests docs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "embedded-postgres": "17.9.0-beta.16",
    "prettier": "3.8.1"
  }
}
